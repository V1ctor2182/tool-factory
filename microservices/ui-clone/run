#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import traceback
from dataclasses import dataclass, field
from pathlib import Path
from urllib.parse import urljoin, urlparse

ROOT = Path(__file__).resolve().parent
ATOMS = ROOT.parent.parent / "atoms"
MANIFEST = json.loads((ROOT / "manifest.json").read_text(encoding="utf-8"))
SITES = json.loads((ROOT / "sites.json").read_text(encoding="utf-8"))
OUTCOMES = ("kept", "locked", "skipped", "needs-terms", "failed")
SITE_OUTCOMES = ("kept", "exists", "rebuilt", "below-target", "would-rebuild", "no-steps", "rebuild-failed", "needs-terms", "skipped", "failed")
HALTS = ("rate_limited", "blocked", "preview_down")
DEFAULT_MATCH = r"^/components/[^/]+/?$"
STEPS_TRIES = 2
CODE_TYPES = ("registry:ui", "registry:block", "registry:component")
ENV = {**os.environ, "TOOL_FACTORY_CALLER": "ui-clone"}
HOME = Path(os.environ.get("TOOL_FACTORY_HOME") or "~/.local/share/tool-factory").expanduser().absolute()
REBUILD_LICENSE = "Rebuilt from observation; no source code copied"
PROBLEM_CHARS = 4000


PREVIEW_STAGE = '[data-slot="preview-stage"]'

class AtomFailed(Exception):
    def __init__(self, error: dict):
        super().__init__(error["message"])
        self.error = error


@dataclass(frozen=True)
class Site:
    id: str
    url: str
    index: str | None
    base: str | None
    keep_code: bool
    terms: str | None
    theme: dict
    catalog: str | None = None
    match: str = DEFAULT_MATCH
    page: str | None = None
    stage: str | None = None
    aliases: dict[str, str] = field(default_factory=dict)
    viewport: dict | None = None


@dataclass(frozen=True)
class Component:
    name: str
    type: str | None
    itemUrl: str | None
    pageUrl: str | None


def log(message: str) -> None:
    print(f"ui-clone: {message}", file=sys.stderr, flush=True)


def atom(name: str, *args: str) -> dict:
    done = subprocess.run([str(ATOMS / name / "bin" / name), *args, "--json"], stdout=subprocess.PIPE, text=True, env=ENV)
    try:
        result = json.loads(done.stdout)
    except ValueError:
        result = None
    if isinstance(result, dict) and isinstance(result.get("error"), dict):
        raise AtomFailed(result["error"])
    if done.returncode or not isinstance(result, dict):
        wanted = "an error" if done.returncode else "a result"
        raise AtomFailed({"code": "internal", "message": f"{name} exited {done.returncode} without {wanted} object on stdout"})
    return result


def host_of(url: str) -> str:
    return (urlparse(url).hostname or "").removeprefix("www.")


def site_of(text: str) -> Site:
    if text in SITES:
        key = text
    elif re.match(r"^https?://", text):
        key = next((k for k, s in SITES.items() if host_of(s["url"]) == host_of(text)), None)
        if key is None:
            return Site(host_of(text), text, None, None, False, None, {})
    else:
        raise AtomFailed({"code": "invalid_args", "message": f"{text} is neither a site in sites.json ({', '.join(SITES)}) nor an http or https URL"})
    entry = SITES[key]
    return Site(
        key, entry["url"], entry.get("index"), entry.get("base"), entry["keepCode"], entry["terms"], entry.get("theme", {}),
        entry.get("catalog"), entry.get("match", DEFAULT_MATCH), entry.get("page"), entry.get("stage"), entry.get("aliases", {}), entry.get("viewport"),
    )


def halts(error: dict) -> bool:
    return error["code"] in HALTS or error["message"].endswith("HTTP 429")


def one_by_one(items: list, blank, decide) -> list[dict]:
    """Stops the site at the first 429 or bot check: that item fails and the rest are skipped, never retried."""
    rows, stopped = [], None
    for n, item in enumerate(items, 1):
        row = blank(item)
        if stopped:
            row.update(outcome="skipped", detail=f"not tried after {stopped}")
        else:
            try:
                decide(item, row)
            except AtomFailed as e:
                if not halts(e.error):
                    raise
                stopped = f"{e.error['code']}: {e.error['message']}"
                row.update(outcome="failed", detail=stopped)
        log(f"{n}/{len(items)} {row['name']}: {row['outcome']}{f' ({row['detail']})' if row['detail'] else ''}")
        rows.append(row)
    return rows


def catalog_of(site: Site) -> dict:
    args = ["registry", site.index or site.url, *(["--base", site.base] if site.base else [])]
    log(f"ui-catalog {' '.join(args)}")
    return atom("ui-catalog", *args)


def chosen(site: Site, items: list, only: str | None, limit: int | None, name=lambda item: item["name"]) -> list:
    if only:
        wanted = [n.strip() for n in only.split(",") if n.strip()]
        missing = sorted(set(wanted) - {name(item) for item in items})
        if missing:
            raise AtomFailed({"code": "invalid_args", "message": f"{site.id} lists no component named {', '.join(missing)}"})
        items = [item for item in items if name(item) in wanted]
    return items if limit is None else items[:limit]


def components_of(site: Site, only: str | None, limit: int | None) -> list[dict]:
    return chosen(site, catalog_of(site)["items"], only, limit)


def slug_of(url: str) -> str:
    return urlparse(url).path.rstrip("/").rsplit("/", 1)[-1]


def inventory(site: Site, only: str | None, limit: int | None) -> list[Component]:
    """The site's registry items in its order, then catalog pages no item covers, in page order. A page and an item share a row when the page's slug, or its alias in sites.json, is the item's name."""
    try:
        catalog = catalog_of(site)
    except AtomFailed as e:
        if e.error["code"] != "invalid_source" and not e.error["message"].startswith("HTTP 404"):
            raise
        log(f"{site.id} has no shadcn registry: {e.error['message']}")
        catalog = {"items": [], "index": None}
    pages: dict[str, str] = {}
    if site.catalog:
        log(f"page-links list {site.catalog} --match {site.match}")
        for link in atom("page-links", "list", site.catalog, "--match", site.match)["items"]:
            pages.setdefault(site.aliases.get(slug_of(link["url"]), slug_of(link["url"])), link["url"])
    template = lambda name: site.page.replace("{name}", name) if site.page else None
    rows = {item["name"]: Component(item["name"], item["type"], item["itemUrl"], pages.get(item["name"]) or template(item["name"])) for item in catalog["items"]}
    base = site.base or (catalog["index"] and urljoin(catalog["index"], "."))
    for name, url in pages.items():
        if name not in rows:
            rows[name] = Component(name, None, urljoin(base, f"{name}.json") if base and name in site.aliases.values() else None, url)
    return chosen(site, list(rows.values()), only, limit, lambda c: c.name)


def by_code(site: Site, item: dict, into: Path, dry_run: bool) -> tuple[str, str | None]:
    if item["type"] is not None and item["type"] not in CODE_TYPES:
        return "skipped", f"type {item['type']}"
    if not site.keep_code:
        return "needs-terms", f"sites.json has no terms for {site.id}" if site.terms is None else f"the terms do not allow keeping code: {site.terms}"
    try:
        fetched = atom("ui-source", "registry", item["itemUrl"])
    except AtomFailed as e:
        if halts(e.error):
            raise
        return "failed", f"{e.error['code']}: {e.error['message']}"
    if fetched["item"] is None:
        return "locked", f"HTTP 401 from {item['itemUrl']}"
    if not fetched["exposed"]:
        return "locked", "the item's files carry no code"
    if dry_run:
        return "kept", "dry run, not written"
    css_vars = fetched["item"].setdefault("cssVars", {})
    css_vars["theme"] = {**site.theme, **css_vars.get("theme", {})}
    added = subprocess.run(
        ["node", str(into / "scripts" / "add.mjs"), "--license", site.terms, "--site", site.id],
        input=json.dumps(fetched),
        capture_output=True,
        text=True,
    )
    if added.returncode:
        return "failed", f"add.mjs exited {added.returncode}: {added.stderr.strip()}"
    return "kept", added.stdout.strip()


def victor_ui(path: str) -> Path:
    into = Path(path).expanduser().absolute()
    if not (into / "scripts" / "add.mjs").is_file():
        raise AtomFailed({"code": "invalid_args", "message": f"{into} has no scripts/add.mjs, so it is not a victor-ui repo"})
    return into


def collect(args) -> dict:
    into = victor_ui(args.into)
    site = site_of(args.site)
    items = components_of(site, args.only, args.limit)

    def decide(item: dict, row: dict) -> None:
        row["outcome"], row["detail"] = by_code(site, item, into, args.dryRun)

    rows = one_by_one(items, lambda item: {"name": item["name"], "itemUrl": item["itemUrl"], "outcome": None, "detail": None}, decide)
    counts = {outcome: sum(row["outcome"] == outcome for row in rows) for outcome in OUTCOMES}
    return {"site": site.id, "into": str(into), "dryRun": args.dryRun, "items": rows, "counts": counts}


def text_of(report: dict) -> str:
    width = max((len(row["name"]) for row in report["items"]), default=0)
    lines = [f"{row['outcome']:<11} {row['name']:<{width}}  {row['detail'] or ''}".rstrip() for row in report["items"]]
    counts = ", ".join(f"{n} {outcome}" for outcome, n in report["counts"].items() if n)
    return "\n".join([*lines, f"{report['site']}: {counts or 'no components'}{' (dry run)' if report['dryRun'] else ''}"])


def recording_of(steps: str, url: str | None) -> str:
    log(f"page-record capture {steps}{f' --url {url}' if url else ''}")
    recording = atom("page-record", "capture", steps, *(["--url", url] if url else []))
    return str(Path(recording["dir"]) / "recording.json")


def diff_of(steps: str, original: str, url: str) -> dict:
    recorded = recording_of(steps, url)
    log(f"page-diff compare {original} {recorded}")
    return atom("page-diff", "compare", original, recorded)


def judge(args) -> dict:
    return diff_of(args.steps, args.original or recording_of(args.steps, None), args.rebuild)


def install(into: Path, source: str, draft: dict, meta: dict) -> None:
    piped = {"source": source, "exposed": True, "item": draft["item"], "demo": draft["demo"], "meta": meta}
    added = subprocess.run(
        ["node", str(into / "scripts" / "add.mjs"), "--license", REBUILD_LICENSE, "--rebuild"],
        input=json.dumps(piped),
        capture_output=True,
        text=True,
    )
    if added.returncode:
        raise AtomFailed({"code": "internal", "message": f"add.mjs exited {added.returncode}: {added.stderr.strip()}"})
    log(added.stdout.strip())


def held(into: Path, name: str) -> tuple[dict, dict[Path, bytes]] | None:
    """A rebuild's registry item and files, to put back if a --redo of it fails."""
    try:
        items = json.loads((into / "registry.json").read_text(encoding="utf-8"))["items"]
    except FileNotFoundError:
        return None
    item = next((item for item in items if item["name"] == name), None)
    files = [*(into / "registry" / name).glob("*"), into / "preview" / "demos" / f"{name}.tsx"]
    return item and (item, {path: path.read_bytes() for path in files if path.is_file()})


def withdraw(into: Path, name: str, before: tuple[dict, dict[Path, bytes]] | None) -> None:
    """Take out a rebuild no round of which was judged, or put back the one it replaced. Left in, its type errors would fail every later component's typecheck, and a rerun would count it as done."""
    path = into / "registry.json"
    registry = json.loads(path.read_text(encoding="utf-8"))
    registry["items"] = [item for item in registry["items"] if item["name"] != name] + ([before[0]] if before else [])
    path.write_text(json.dumps(registry, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    shutil.rmtree(into / "registry" / name, ignore_errors=True)
    (into / "preview" / "demos" / f"{name}.tsx").unlink(missing_ok=True)
    for file, content in before[1].items() if before else ():
        file.parent.mkdir(parents=True, exist_ok=True)
        file.write_bytes(content)
    log(f"{'restored' if before else 'withdrew'} {name}")


def typecheck(into: Path) -> str | None:
    checked = subprocess.run(["npm", "run", "--silent", "typecheck"], cwd=into, capture_output=True, text=True)
    output = (checked.stdout + checked.stderr).strip()
    return None if checked.returncode == 0 else output[:PROBLEM_CHARS] or f"npm run typecheck exited {checked.returncode}"


def saved(path: Path, result: dict) -> str:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(result, indent=2), encoding="utf-8")
    return str(path)


def check_loop(args) -> None:
    if args.rounds < 1 or not 0 < args.target <= 1:
        raise AtomFailed({"code": "invalid_args", "message": "--rounds must be 1 or more and --target between 0 and 1"})


def rebuild(args) -> dict:
    into = victor_ui(args.into)
    check_loop(args)
    return rebuilt(into, args.steps, args.name, args)


def rebuilt(into: Path, steps: str, name: str, args, original: str | None = None, judged: str | None = None) -> dict:
    """The judged loop both rebuild and site run. original is a recording of steps already made, so it is not recorded again. judged is the steps the rebuild is recorded with, when its selectors differ from the original's."""
    try:
        source = json.loads(Path(steps).read_text(encoding="utf-8"))["url"]
        packages = ",".join(sorted(json.loads((into / "package.json").read_text(encoding="utf-8")).get("dependencies", {})))
    except (OSError, ValueError, KeyError, TypeError) as e:
        raise AtomFailed({"code": "invalid_args", "message": f"Cannot read the steps file's url or victor-ui's package.json: {e}"}) from None
    folder = HOME / "microservices" / "ui-clone" / "rebuild" / name
    page = f"{args.preview.rstrip('/')}/{name}"
    original = original or recording_of(steps, None)
    rounds: list[dict] = []
    previous = diff = problem = None
    for n in range(1, args.rounds + 1):
        row = {"round": n, "draft": None, "diff": None, "score": None, "error": None, "costUsd": 0.0}
        rounds.append(row)
        revise = [*(["--previous", previous] if previous else []), *(["--diff", diff] if diff else []), *(["--problem", problem] if problem else [])]
        log(f"round {n}: ui-draft write {name}{' revising' if previous else ''}")
        try:
            draft = atom("ui-draft", "write", original, "--name", name, "--packages", packages, *revise)
            row["costUsd"] = draft["costUsd"]
            previous = row["draft"] = saved(folder / f"round-{n}" / "draft.json", draft)
            diff = problem = None
            install(into, source, draft, {"rebuild": {"round": n, "score": None, "costUsd": draft["costUsd"]}})
        except AtomFailed as e:
            row["error"] = f"{e.error['code']}: {e.error['message']}"
            break
        problem = typecheck(into)
        if problem is None:
            try:
                result = diff_of(judged or steps, original, page)
            except AtomFailed as e:
                if e.error["code"] != "invalid_source":
                    row["error"] = f"{e.error['code']}: {e.error['message']}"
                    break
                problem = f"The judge could not record the demo at {page}: {e.error['message']}"
        if problem:
            row["error"] = problem
            log(f"round {n}: {headline(problem)}")
            continue
        diff = row["diff"] = saved(folder / f"round-{n}" / "diff.json", result)
        row["score"] = result["score"]
        log(f"round {n}: score {result['score']:.4f}")
        if result["score"] >= args.target:
            break
    cost = sum(row["costUsd"] for row in rounds)
    best = max((row for row in rounds if row["score"] is not None), key=lambda row: row["score"], default=None)
    if best:
        summary = [{"round": row["round"], "score": row["score"], "costUsd": row["costUsd"]} for row in rounds]
        meta = {"rebuild": {"round": best["round"], "score": best["score"], "costUsd": cost, "rounds": summary}}
        install(into, source, json.loads(Path(best["draft"]).read_text(encoding="utf-8")), meta)
        if failed := typecheck(into):
            raise AtomFailed({"code": "internal", "message": f"Round {best['round']} passed its typecheck before, but not when reinstalled: {failed}"})
    return {
        "name": name,
        "source": source,
        "into": str(into),
        "target": args.target,
        "passed": bool(best and best["score"] >= args.target),
        "best": best and {"round": best["round"], "score": best["score"]},
        "costUsd": cost,
        "rounds": rounds,
    }


def in_victor_ui(into: Path) -> tuple[dict[str, dict], set[str]]:
    """Each registry item by its meta.source, the itemUrl it was collected from or the page it was rebuilt from, and every name."""
    try:
        items = json.loads((into / "registry.json").read_text(encoding="utf-8"))["items"]
    except FileNotFoundError:
        items = []
    sources = {item["meta"]["source"]: item for item in items if item.get("meta", {}).get("source")}
    return sources, {item["name"] for item in items}


def launched(recording: str, page: str) -> str | None:
    """The full-page preview a demo opens when the demo is only a link to it, under the component's own page."""
    try:
        state = json.loads(Path(recording).read_text(encoding="utf-8"))["states"][0]
        dom = Path(state["dom"]).read_text(encoding="utf-8")
    except FileNotFoundError:
        return None
    link = re.match(r'<a\b[^>]*\bhref="([^"]+)"', dom)
    href = urljoin(page, link[1]) if link else None
    return href if href and urlparse(href).path.startswith(urlparse(page).path.rstrip("/") + "/") else None


def for_preview(steps: dict, root: str) -> dict:
    """The same steps with the page's root swapped for victor-ui's preview stage."""
    swap = lambda selector: re.sub(rf"(?<![\w.#\"'=-]){re.escape(root)}(?![\w-])", lambda _: PREVIEW_STAGE, selector)
    states = [{**state, "actions": [{**action, "selector": swap(action["selector"])} if "selector" in action else action for action in state["actions"]]} for state in steps["states"]]
    return {**steps, "target": swap(steps["target"]), "states": states}


def steps_for(site: Site, c: Component, row: dict) -> tuple[str, str, str] | None:
    """Survey the page's idle state, have ui-steps write the states, and record the original with them. Returns the steps file, that recording, and the steps the rebuild is judged with, or None after setting row's outcome."""
    folder = HOME / "microservices" / "ui-clone" / "site" / site.id / c.name

    def surveyed(url: str, root: str) -> str:
        # The target is the demo inside the stage. A site's stage and victor-ui's are sized by their pages, so recording the stage compares two page layouts.
        plan = {"url": url, "target": f"{root} > *", **({"viewport": site.viewport} if site.viewport else {}), "states": [{"name": "idle", "actions": []}]}
        return recording_of(saved(folder / "survey.json", plan), None)

    root = site.stage
    try:
        idle = surveyed(c.pageUrl, root)
        if full := launched(idle, c.pageUrl):
            root = "body"
            idle = surveyed(full, root)
    except AtomFailed as e:
        if halts(e.error):
            raise
        row.update(outcome="no-steps", detail=f"page-record could not survey {c.pageUrl}: {e.error['code']}: {e.error['message']}")
        return None
    problem = None
    for _ in range(STEPS_TRIES):
        log(f"ui-steps write {idle}{' with the last problem' if problem else ''}")
        try:
            written = atom("ui-steps", "write", idle, *(["--problem", problem] if problem else []))
        except AtomFailed as e:
            row.update(outcome="no-steps", detail=f"ui-steps: {e.error['code']}: {e.error['message']}")
            return None
        row["costUsd"] += written["costUsd"]
        row["stepsFile"] = saved(folder / "steps.json", written["steps"])
        try:
            recording = recording_of(row["stepsFile"], None)
            judged = saved(folder / "rebuild-steps.json", for_preview(written["steps"], root))
            return row["stepsFile"], recording, judged
        except AtomFailed as e:
            if halts(e.error):
                raise
            if e.error["code"] != "invalid_source":
                row.update(outcome="no-steps", detail=f"page-record could not record with the steps: {e.error['code']}: {e.error['message']}")
                return None
            problem = f"page-record: {e.error['message']}"
    row.update(outcome="no-steps", detail=f"the steps failed {STEPS_TRIES} times, last with {problem}")
    return None


def rebuild_name(site: Site, slug: str, taken: set[str]) -> str:
    name = f"{slug}-rebuild"
    return f"{site.id}-{name}" if name in taken else name


def site(args) -> dict:
    into = victor_ui(args.into)
    check_loop(args)
    where = site_of(args.site)
    components = inventory(where, args.only, args.limit)
    sources, names = in_victor_ui(into)

    def decide(c: Component, row: dict) -> None:
        # A demo that links to its own preview page is rebuilt from that page, so the item's source sits under pageUrl.
        known = sources.get(c.itemUrl or "") or sources.get(c.pageUrl or "") or next((item for source, item in sources.items() if c.pageUrl and source.startswith(f"{c.pageUrl}/")), None)
        if known and not (args.redo and known["meta"].get("method") == "rebuild"):
            row.update(outcome="exists", detail=f"in victor-ui as {known['name']}")
            return
        why = "no registry item"
        if c.itemUrl:
            outcome, detail = by_code(where, {"type": c.type, "itemUrl": c.itemUrl}, into, args.dryRun)
            if outcome != "locked":
                row.update(outcome=outcome, detail=detail)
                return
            why = f"locked, {detail}"
        if not c.pageUrl or not where.stage:
            row.update(outcome="skipped", detail=f"{why}, and {'no page to record' if not c.pageUrl else f'sites.json has no stage for {where.id}'}")
            return
        if args.dryRun:
            row.update(outcome="would-rebuild", detail=f"{why}, from {c.pageUrl}")
            return
        found = steps_for(where, c, row)
        if found is None:
            return
        name = known["name"] if known else rebuild_name(where, c.name, names)
        before = held(into, name)
        try:
            report = rebuilt(into, found[0], name, args, found[1], found[2])
        except AtomFailed as e:
            withdraw(into, name, before)
            if halts(e.error):
                raise
            row.update(outcome="rebuild-failed", detail=f"{e.error['code']}: {e.error['message']}")
            return
        row["costUsd"] += report["costUsd"]
        if report["best"] is None:
            withdraw(into, name, before)
            last = report["rounds"][-1]["error"] or "error unknown"
            if last.startswith(f"network_error: {args.preview.rstrip('/')}/"):
                raise AtomFailed({"code": "preview_down", "message": f"The victor-ui preview at {args.preview} is not answering: {headline(last)}"})
            row.update(outcome="rebuild-failed", detail=f"{name}: no round was judged, last {headline(last)}")
            return
        row["score"] = report["best"]["score"]
        row.update(outcome="rebuilt" if report["passed"] else "below-target", detail=f"{name}, best round {report['best']['round']} of {len(report['rounds'])}")

    blank = lambda c: {"name": c.name, "itemUrl": c.itemUrl, "pageUrl": c.pageUrl, "outcome": None, "detail": None, "score": None, "costUsd": 0.0, "stepsFile": None}
    rows = one_by_one(components, blank, decide)
    counts = {outcome: sum(row["outcome"] == outcome for row in rows) for outcome in SITE_OUTCOMES}
    cost = round(sum(row["costUsd"] for row in rows), 6)
    return {"site": where.id, "into": str(into), "target": args.target, "dryRun": args.dryRun, "items": rows, "counts": counts, "costUsd": cost}


def text_of_site(report: dict) -> str:
    width = max((len(row["name"]) for row in report["items"]), default=0)
    lines = [
        f"{row['outcome']:<14} {row['name']:<{width}}  {'' if row['score'] is None else f'{row['score']:.4f}':>6}  ${row['costUsd']:.2f}  {row['detail'] or ''}".rstrip()
        for row in report["items"]
    ]
    counts = ", ".join(f"{n} {outcome}" for outcome, n in report["counts"].items() if n)
    return "\n".join([*lines, f"{report['site']}: {counts or 'no components'}, ${report['costUsd']:.2f} in all{' (dry run)' if report['dryRun'] else ''}"])


def headline(error: str) -> str:
    lines = error.splitlines()
    return next((line for line in lines if "error" in line.lower()), lines[0])


def text_of_rebuild(report: dict) -> str:
    lines = []
    for row in report["rounds"]:
        result = f"{row['score']:.4f}" if row["score"] is not None else "error "
        detail = f"  {headline(row['error'])}" if row["error"] else ""
        lines.append(f"round {row['round']}  {result}  ${row['costUsd']:.2f}{detail}")
    best = report["best"]
    verdict = f"best round {best['round']} at {best['score']:.4f}, {'passed' if report['passed'] else 'below'} {report['target']}" if best else "no round was judged"
    return "\n".join([*lines, f"total    ${report['costUsd']:.2f}  {verdict}"])


def text_of_diff(diff: dict) -> str:
    width = max((len(state["name"]) for state in diff["states"]), default=0)
    lines = [f"{state['name']:<{width}}  {state['score']:.4f}" for state in diff["states"]]
    return "\n".join([*lines, f"score {diff['score']:.4f}"])


RUN = {"collect": (collect, text_of), "judge": (judge, text_of_diff), "rebuild": (rebuild, text_of_rebuild), "site": (site, text_of_site)}


class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise AtomFailed({"code": "invalid_args", "message": message})


def flag_of(name: str) -> str:
    return "--" + re.sub(r"(?<!^)(?=[A-Z])", "-", name).lower()


def parser() -> Parser:
    p = Parser(prog=MANIFEST["name"], description=MANIFEST["description"], epilog="Without a verb, run <site> means collect <site>.")
    verbs = p.add_subparsers(dest="verb", required=True, parser_class=Parser)
    for verb in MANIFEST["verbs"]:
        v = verbs.add_parser(verb["name"], help=verb["description"], description=verb["description"])
        schema = verb["input"]
        for name, prop in schema["properties"].items():
            required = name in schema["required"]
            if required and not prop.get("x-flag"):
                v.add_argument(name, help=prop["description"])
            elif prop["type"] == "boolean":
                v.add_argument(flag_of(name), dest=name, action="store_true", help=prop["description"])
            else:
                kind = {"integer": int, "number": float}.get(prop["type"], str)
                v.add_argument(flag_of(name), dest=name, type=kind, required=required, default=prop.get("default"), help=prop["description"])
        v.add_argument("--json", action="store_true", help="Print one JSON object.")
    return p


def verb_args(argv: list[str]) -> list[str]:
    if argv and argv[0] in (*RUN, "-h", "--help"):
        return argv
    return ["collect", *argv]


def main() -> int:
    as_json = "--json" in sys.argv[1:]
    try:
        args = parser().parse_args(verb_args(sys.argv[1:]))
        run, text = RUN[args.verb]
        report = run(args)
        print(json.dumps(report, ensure_ascii=False) if as_json else text(report))
        return 0
    except AtomFailed as e:
        error = e.error
    except Exception as e:
        traceback.print_exc()
        error = {"code": "internal", "message": f"{type(e).__name__}: {e}"}
    if as_json:
        print(json.dumps({"error": error}, ensure_ascii=False))
    else:
        print(f"ui-clone: {error['code']}: {error['message']}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
