#!/usr/bin/env -S uv run --quiet --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import traceback
from pathlib import Path
from urllib.parse import parse_qs, urlparse

ROOT = Path(__file__).resolve().parent
ATOMS = ROOT.parent.parent / "atoms"
MANIFEST = json.loads((ROOT / "manifest.json").read_text(encoding="utf-8"))
HOME = Path(os.environ.get("TOOL_FACTORY_HOME") or "~/.local/share/tool-factory").expanduser().absolute()
MAX_FRAMES = 8
LIST_PATHS = ("/playlist", "/@", "/channel/", "/c/", "/user/")


class AtomFailed(Exception):
    def __init__(self, error: dict):
        super().__init__(error["message"])
        self.error = error


def log(message: str) -> None:
    print(f"youtube: {message}", file=sys.stderr, flush=True)


def bin_of(name: str) -> str:
    return str(ATOMS / name / "bin" / name)


ENV = {**os.environ, "TOOL_FACTORY_CALLER": "youtube"}


def atom(name: str, *args: str) -> dict:
    done = subprocess.run([bin_of(name), *args, "--json"], stdout=subprocess.PIPE, text=True, env=ENV)
    try:
        result = json.loads(done.stdout)
    except ValueError:
        result = {"error": {"code": "internal", "message": f"{name} exited {done.returncode} with no JSON on stdout"}}
    if "error" in result:
        raise AtomFailed(result["error"])
    return result


def transcript_of(url: str) -> dict:
    log(f"captions get {url}")
    try:
        return atom("captions", "get", url)
    except AtomFailed as e:
        if e.error["code"] != "no_captions":
            raise
    log("no captions, so downloading the audio")
    media = atom("download", "get", url, "--audio")
    log(f"transcribe file {media['path']}")
    return {**atom("transcribe", "file", media["path"]), "source": url}


def is_url(text: str) -> bool:
    return bool(re.match(r"^[A-Za-z][A-Za-z0-9+.-]*://", text))


def is_list(text: str) -> bool:
    url = urlparse(text)
    query = parse_qs(url.query)
    return ("list" in query and "v" not in query) or url.path.startswith(LIST_PATHS)


def videos_of(text: str, limit: int | None) -> list[dict]:
    if not is_url(text):
        args = ["search", text, "--site", "ytsearch", "--limit", str(1 if limit is None else limit)]
    elif is_list(text):
        args = ["list", text, *([] if limit is None else ["--limit", str(limit)])]
    else:
        return [{"url": text, "title": None}]
    log(f"find-url {' '.join(args)}")
    found = atom("find-url", *args)
    if not found["items"]:
        raise AtomFailed({"code": "no_results", "message": f"No videos found for {text}"})
    return found["items"]


def evenly(items: list, count: int) -> list:
    if len(items) <= count:
        return items
    return [items[round(i * (len(items) - 1) / (count - 1))] for i in range(count)]


def image_notes_of(url: str) -> dict:
    log("downloading the video for --visual")
    media = atom("download", "get", url, "--video")
    log(f"frames get {media['path']}")
    frames = evenly(atom("frames", "get", media["path"])["frames"], MAX_FRAMES)
    log(f"see describe {len(frames)} frames")
    notes = atom("see", "describe", *[frame["path"] for frame in frames])
    for image, frame in zip(notes["images"], frames):
        image["time"] = frame["time"]
    return notes


def save(kind: str, record: dict) -> Path:
    stable = json.dumps({k: v for k, v in record.items() if k not in ("cacheHit", "costUsd")}, sort_keys=True)
    folder = HOME / "youtube" / kind
    folder.mkdir(parents=True, exist_ok=True)
    path = folder / f"{hashlib.sha256(stable.encode()).hexdigest()[:32]}.json"
    path.write_text(json.dumps(record, ensure_ascii=False, indent=2), encoding="utf-8")
    return path


def digest_args(url: str, visual: bool) -> list[str]:
    args = ["make", "--transcript", str(save("transcripts", transcript_of(url)))]
    if visual:
        args += ["--image-notes", str(save("image-notes", image_notes_of(url)))]
    log(f"digest {' '.join(args)}")
    return args


def timed_lines(transcript: dict) -> str:
    return "\n".join("[%d:%02d] %s" % (*divmod(int(s["start"]), 60), s["text"]) for s in transcript["segments"])


def get(args, as_json: bool) -> int:
    command = digest_args(args.input, args.visual)
    if not as_json:
        return subprocess.run([bin_of("digest"), *command], env=ENV).returncode
    print(json.dumps(atom("digest", *command), ensure_ascii=False))
    return 0


def transcript(args, as_json: bool) -> int:
    found = transcript_of(args.input)
    print(json.dumps(found, ensure_ascii=False) if as_json else timed_lines(found))
    return 0


def search(args, as_json: bool) -> int:
    videos = videos_of(args.input, args.limit)
    items, failed, done = [], [], 0
    for n, video in enumerate(videos):
        if not as_json:
            print(f"{'\n' if n else ''}# {video['title'] or video['url']}\n{video['url']}\n", flush=True)
        try:
            command = digest_args(video["url"], args.visual)
            if as_json:
                items.append(atom("digest", *command))
            elif subprocess.run([bin_of("digest"), *command], env=ENV).returncode == 0:
                done += 1
        except AtomFailed as e:
            failed.append({"url": video["url"], "error": e.error})
            if not as_json:
                print(f"youtube: {e.error['code']}: {e.error['message']}", file=sys.stderr, flush=True)
    if as_json and not items:
        raise AtomFailed(failed[0]["error"])
    if as_json:
        print(json.dumps({"items": items, "failed": failed}, ensure_ascii=False))
    return 0 if items or done else 1


RUN = {"get": get, "transcript": transcript, "search": search}


class Parser(argparse.ArgumentParser):
    def error(self, message):
        raise AtomFailed({"code": "invalid_args", "message": message})


VERBS = {verb["name"]: verb for verb in MANIFEST["verbs"]}


def flag_of(name: str) -> str:
    return "--" + re.sub(r"(?<!^)(?=[A-Z])", "-", name).lower()


def parser() -> Parser:
    p = Parser(
        prog=MANIFEST["name"],
        description=MANIFEST["description"],
        epilog="Without a verb, run <video url> means get, run <words or list url> means search, and --no-digest means transcript.",
    )
    verbs = p.add_subparsers(dest="verb", required=True, parser_class=Parser)
    for verb in MANIFEST["verbs"]:
        v = verbs.add_parser(verb["name"], help=verb["description"], description=verb["description"])
        schema = verb["input"]
        for name, prop in schema["properties"].items():
            if name in schema["required"]:
                v.add_argument(name, help=prop["description"])
            elif prop["type"] == "integer":
                v.add_argument(flag_of(name), dest=name, type=int, help=prop["description"])
            else:
                v.add_argument(flag_of(name), dest=name, action="store_true", help=prop["description"])
        v.add_argument("--json", action="store_true", help="Print one JSON object.")
    return p


VALUE_FLAGS = {
    flag_of(name) for verb in MANIFEST["verbs"] for name, prop in verb["input"]["properties"].items() if prop["type"] == "integer"
}


def verb_args(argv: list[str]) -> list[str]:
    flags = [a for a in argv if a == "--json"]
    words = [a for a in argv if a != "--json"]
    if words and words[0] in (*VERBS, "-h", "--help"):
        return [*words, *flags]
    inputs = [a for i, a in enumerate(words) if not a.startswith("-") and (i == 0 or words[i - 1] not in VALUE_FLAGS)]
    if "--no-digest" in words:
        verb = "transcript"
    elif inputs and (not is_url(inputs[0]) or is_list(inputs[0])):
        verb = "search"
    else:
        verb = "get"
    return [verb, *(a for a in words if a != "--no-digest"), *flags]


def main() -> int:
    as_json = "--json" in sys.argv[1:]
    try:
        args = parser().parse_args(verb_args(sys.argv[1:]))
        return RUN[args.verb](args, as_json)
    except AtomFailed as e:
        error = e.error
    except Exception as e:
        traceback.print_exc()
        error = {"code": "internal", "message": f"{type(e).__name__}: {e}"}
    if as_json:
        print(json.dumps({"error": error}, ensure_ascii=False))
    else:
        print(f"youtube: {error['code']}: {error['message']}", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
