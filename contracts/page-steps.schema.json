{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://victor-tool-factory.local/contracts/page-steps.schema.json",
  "title": "Page steps",
  "description": "A script of states to drive one page through. Each state's actions run after the previous state's, like one user session, so the same script recorded against an original and a rebuild yields comparable states.",
  "type": "object",
  "properties": {
    "url": { "type": "string", "pattern": "^(https?|file)://", "description": "The page to record." },
    "target": { "type": "string", "minLength": 1, "default": "body", "description": "CSS selector of the element to record, such as a component root. Screenshots, DOM, and styles cover this element." },
    "viewport": {
      "type": "object",
      "default": { "width": 1280, "height": 800 },
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "required": ["width", "height"],
      "additionalProperties": false
    },
    "colorScheme": { "enum": ["light", "dark"], "default": "dark" },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
          "frames": {
            "type": "object",
            "description": "Take a screenshot every everyMs of page time for forMs after the actions. Frame i is at exactly i * everyMs.",
            "properties": {
              "everyMs": { "type": "integer", "minimum": 1 },
              "forMs": { "type": "integer", "minimum": 1 }
            },
            "required": ["everyMs", "forMs"],
            "additionalProperties": false
          },
          "sweep": {
            "type": "object",
            "description": "After the state settles, move the pointer, unpressed, to the middle of each cell of a grid over the target, and record how the page answers at each point. The pointer ends parked at the viewport's corner, so a later state that needs a hover asks for it again.",
            "properties": {
              "cols": { "type": "integer", "minimum": 1, "maximum": 32 },
              "rows": { "type": "integer", "minimum": 1, "maximum": 32 },
              "dwellMs": { "type": "integer", "minimum": 0, "default": 800, "description": "Page time to wait at each point before it counts as settled, longer than the page's slowest pointer transition." }
            },
            "required": ["cols", "rows"],
            "additionalProperties": false
          }
        },
        "required": ["name", "actions"],
        "additionalProperties": false
      }
    }
  },
  "required": ["url", "states"],
  "additionalProperties": false,
  "$defs": {
    "action": {
      "type": "object",
      "properties": {
        "do": { "enum": ["hover", "click", "focus", "type", "press", "paste", "wait", "scroll", "drag", "drop"] },
        "selector": { "type": "string", "minLength": 1, "description": "CSS selector. type, press, and paste act on the focused element when it is absent." },
        "text": { "type": "string" },
        "key": { "type": "string", "minLength": 1, "description": "A Playwright key name, such as Enter or Backspace." },
        "ms": { "type": "integer", "minimum": 0, "description": "Page time to advance. The page clock and animations move, real time does not matter." },
        "by": {
          "type": "object",
          "description": "How far a drag moves the pointer from the middle of its selector, in CSS pixels.",
          "properties": { "x": { "type": "integer" }, "y": { "type": "integer" } },
          "required": ["x", "y"],
          "additionalProperties": false
        }
      },
      "required": ["do"],
      "additionalProperties": false,
      "allOf": [
        { "if": { "properties": { "do": { "enum": ["hover", "click", "focus", "scroll", "drag"] } } }, "then": { "required": ["selector"] } },
        { "if": { "properties": { "do": { "enum": ["type", "paste"] } } }, "then": { "required": ["text"] } },
        { "if": { "properties": { "do": { "const": "press" } } }, "then": { "required": ["key"] } },
        { "if": { "properties": { "do": { "const": "wait" } } }, "then": { "required": ["ms"] } },
        { "if": { "properties": { "do": { "const": "drag" } } }, "then": { "required": ["by"] } }
      ]
    }
  }
}
