{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://victor-tool-factory.local/contracts/digest-list.schema.json",
  "title": "Digest list",
  "description": "Digests of the videos a search, a playlist, or a channel resolves to, in the site's order, and the videos that failed.",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "digest.schema.json" }
    },
    "failed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "description": "The video page URL that failed." },
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" }
            },
            "required": ["code", "message"],
            "additionalProperties": false
          }
        },
        "required": ["url", "error"],
        "additionalProperties": false
      }
    }
  },
  "required": ["items", "failed"],
  "additionalProperties": false
}
