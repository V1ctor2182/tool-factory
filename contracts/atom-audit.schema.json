{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://victor-tool-factory.local/contracts/atom-audit.schema.json",
  "title": "Atom audit",
  "description": "Evidence for moving atom code to the kit, merging atoms, or splitting one. It holds no verdict.",
  "type": "object",
  "properties": {
    "minSize": { "type": "integer", "minimum": 1, "description": "Fewest syntax nodes a clone must hold." },
    "clones": {
      "type": "array",
      "description": "Repeated code, largest first.",
      "items": { "$ref": "code-clones.schema.json#/properties/clones/items" }
    },
    "added": {
      "type": "array",
      "description": "With a base folder, the repeated code that the base does not have, largest first.",
      "items": { "$ref": "code-clones.schema.json#/properties/clones/items" }
    },
    "pairs": {
      "type": "array",
      "description": "Atom pairs with repeated code, the highest share first.",
      "items": {
        "type": "object",
        "properties": {
          "atoms": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string", "minLength": 1 } },
          "sharedLines": { "type": "integer", "minimum": 1, "description": "Lines the pair repeats, counted in the atom that holds fewer of them." },
          "shareOfSmaller": { "type": "number", "minimum": 0, "description": "sharedLines over the source lines of the smaller atom." }
        },
        "required": ["atoms", "sharedLines", "shareOfSmaller"],
        "additionalProperties": false
      }
    },
    "large": {
      "type": "array",
      "description": "Atoms large enough to check for a second noun, the largest first.",
      "items": {
        "type": "object",
        "properties": {
          "atom": { "type": "string", "minLength": 1 },
          "lines": { "type": "integer", "minimum": 1 },
          "verbs": { "type": "integer", "minimum": 0 }
        },
        "required": ["atom", "lines", "verbs"],
        "additionalProperties": false
      }
    }
  },
  "required": ["minSize", "clones", "pairs", "large"],
  "additionalProperties": false
}
