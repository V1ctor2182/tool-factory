{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://victor-tool-factory.local/contracts/ui-draft.schema.json",
  "title": "UI draft",
  "description": "A component written from a page recording, as a shadcn registry item plus a demo page. The item has the shape ui-source returns in item, so victor-ui's add.mjs takes it.",
  "type": "object",
  "properties": {
    "model": { "type": "string" },
    "item": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "const": "registry:ui" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "dependencies": { "type": "array", "items": { "type": "string" }, "description": "npm packages the component imports." },
        "css": { "type": "object", "description": "shadcn's css field: selectors and at-rules such as @keyframes, mapping to declarations or nested rules." },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "type": { "const": "registry:ui" },
              "target": { "type": "string", "pattern": "^components/ui/[^/]+\\.tsx$" },
              "content": { "type": "string" }
            },
            "required": ["path", "type", "target", "content"],
            "additionalProperties": false
          }
        }
      },
      "required": ["name", "type", "title", "description", "dependencies", "files"],
      "additionalProperties": false
    },
    "demo": { "type": "string", "description": "TSX source of a default-exported demo page that imports the component from @/components/ui/<name> and carries data-preview-root on its root." },
    "notes": { "type": "string", "description": "What this draft changed from the previous one and why." },
    "costUsd": { "type": "number", "minimum": 0 },
    "cacheHit": { "type": "boolean" }
  },
  "required": ["model", "item", "demo", "notes", "costUsd", "cacheHit"],
  "additionalProperties": false
}
